            className="absolute inset-0 rounded-full bg-gradient-to-br from-[#f5e89d] to-[#f0d86f] blur-xl"
            animate={{
              scale: [1, 1.3, 1],
              opacity: [0.4, 0.2, 0.4],
            }}
            transition={{
              duration: 2,
              repeat: Infinity,
              ease: "easeInOut",
              delay: 0.3,
            }}
            style={{ width: "200px", height: "200px" }}
          />
          <motion.div
            className="relative rounded-full bg-gradient-to-br from-[#f5e89d] via-[#f0d86f] to-[#d4b948] shadow-2xl shadow-[#f0d86f]/50"
            animate={{
              scale: [1, 1.05, 1],
            }}
            transition={{
              duration: 2,
              repeat: Infinity,
              ease: "easeInOut",
            }}
            style={{ width: "200px", height: "200px" }}
          >
            <div className="absolute inset-8 rounded-full bg-gradient-to-br from-[#fef7c8] to-[#f5e89d]" />
            <div className="absolute inset-16 rounded-full bg-gradient-to-br from-[#fffdf0] to-[#fef7c8]" />
          </motion.div>
        </div>

        {/* Text */}
        <h2 className="text-3xl font-semibold text-white mb-3">Transmitting...</h2>
        <p className="text-[#b8d4e0] text-lg mb-8">Converting to light pulses</p>

