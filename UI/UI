import { useState } from "react";
import { useNavigate } from "react-router";
import { ArrowLeft, Camera, Waves } from "lucide-react";
import { motion } from "motion/react";

export function Receive() {
  const navigate = useNavigate();
  const [isReceiving, setIsReceiving] = useState(false);
  const [decodedMessage, setDecodedMessage] = useState("");

  const handleStartCamera = () => {
    setIsReceiving(true);
    // Simulate receiving a message after 3 seconds
    setTimeout(() => {
      setDecodedMessage("HACKENZA");
    }, 3000);
  };

  return (
    <div className="min-h-screen bg-gradient-to-br from-[#2c5f7a] via-[#3a6f8a] to-[#5ba3a8] flex flex-col p-6">
      {/* Header */}
      <div className="flex items-center gap-4 mb-8">
        <button
          onClick={() => navigate("/")}
          className="w-12 h-12 rounded-full bg-[#466b81] hover:bg-[#537789] transition-colors flex items-center justify-center"
        >
          <ArrowLeft className="w-6 h-6 text-white" />
        </button>
        <h1 className="text-2xl font-semibold text-white">Receive Signal</h1>
      </div>

      {/* Content */}
      <div className="flex-1 flex flex-col max-w-md mx-auto w-full">
        {/* Camera Area */}
        <div className="bg-[#0f1d27] rounded-3xl p-12 border-2 border-[#1a3f52] mb-6 flex-1 flex flex-col items-center justify-center">
          {/* Camera Icon with Glow */}
          <motion.div
            className="relative mb-8"
            animate={{
              scale: isReceiving ? [1, 1.1, 1] : 1,
            }}
            transition={{
              duration: 1.5,
              repeat: isReceiving ? Infinity : 0,
              ease: "easeInOut",
            }}
          >
            <motion.div
              className="absolute inset-0 rounded-full bg-[#4a9d7a] blur-2xl"
              animate={{
                opacity: isReceiving ? [0.3, 0.6, 0.3] : 0.4,
              }}
              transition={{
                duration: 1.5,
                repeat: isReceiving ? Infinity : 0,
                ease: "easeInOut",
              }}
              style={{ width: "120px", height: "120px", left: "-10px", top: "-10px" }}
            />
            <div className="relative w-24 h-24 rounded-full bg-[#4a9d7a] flex items-center justify-center">
              <Camera className="w-12 h-12 text-white" strokeWidth={2} />
            </div>
          </motion.div>

          {/* Text */}
          <h2 className="text-2xl font-semibold text-white mb-3 text-center">
            Point Camera at Signal
          </h2>
          <p className="text-[#8fa8b8] text-center mb-8 leading-relaxed">
            Align your camera with the flashlight transmitter to receive and decode the message
          </p>

          {/* Start Camera Button */}
          {!isReceiving && (
            <button
              onClick={handleStartCamera}
              className="bg-[#4a9d7a] hover:bg-[#58b08e] text-white px-8 py-4 rounded-2xl transition-colors flex items-center gap-3 text-lg font-medium"
            >
              <Camera className="w-6 h-6" />
              Start Camera
            </button>
          )}

          {isReceiving && !decodedMessage && (
            <motion.div
              initial={{ opacity: 0 }}
              animate={{ opacity: 1 }}
              className="text-[#6cb4c9] text-lg"
            >
              Scanning for signal...
            </motion.div>
          )}

          {/* Wave Icon */}
          <div className="mt-8">
            <Waves className="w-12 h-12 text-[#2d4a5c]" strokeWidth={2} />
          </div>
        </div>

        {/* Decoded Message */}
        <div className="bg-[#1a2e3d]/80 border border-[#2d4a5c] rounded-xl p-5">
          <div className="flex items-start gap-3">
            <div className="w-2 h-2 rounded-full bg-[#6cb4c9] flex-shrink-0 mt-2" />
            <div className="flex-1">
              <h3 className="text-white font-medium mb-2">Decoded Message</h3>
              {decodedMessage ? (
                <motion.p
                  initial={{ opacity: 0, y: 10 }}
                  animate={{ opacity: 1, y: 0 }}
                  className="text-[#6cb4c9] text-lg font-semibold"
                >
                  {decodedMessage}
                </motion.p>
              ) : (
                <p className="text-[#5a7283] italic">Waiting for signal transmission...</p>
              )}
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}
